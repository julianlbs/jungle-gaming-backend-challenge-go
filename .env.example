# Local development values only. Never put real credentials here.

# Roles enabled in this process: api, consumer, outbox, pending
APP_ROLES=api,consumer,outbox,pending
# INSTANCE_ID defaults to the hostname; docker-compose.yml sets it per instance.
HTTP_ADDR=:8080
METRICS_ADDR=:9090
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=30s

# PostgreSQL: the application connects as wallet_app; migrations run as wallet_owner.
DATABASE_URL=postgres://wallet_app:wallet_app@postgres:5432/wallet?sslmode=disable
MIGRATIONS_DATABASE_URL=postgres://wallet_owner:wallet_owner@postgres:5432/wallet?sslmode=disable
DB_MAX_CONNS=20
DB_LOCK_TIMEOUT=2s
DB_STATEMENT_TIMEOUT=5s
DB_STARTUP_TIMEOUT=30s

# OIDC: tokens carry the public issuer; keys are fetched over the internal network.
OIDC_ISSUER=http://localhost:8080/realms/wallet
OIDC_JWKS_URL=http://keycloak:8080/realms/wallet/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api

# AWS (LocalStack)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
# Keys of the wallet-consumer IAM user, issued by deploy/aws/init-aws.sh into a shared volume.
# Outside Compose, set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY instead.
AWS_SHARED_CREDENTIALS_FILE=/aws/credentials
AWS_PROFILE=wallet-consumer
SQS_WAGER_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localstack:4566/000000000000/wager-transactions-dlq.fifo
SQS_ALLOWED_PROVIDERS=provider-a,provider-b
SQS_MAX_IN_FLIGHT=10
SQS_MESSAGE_TIMEOUT=30s
SNS_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:wallet-events.fifo

# Outbox relay
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_POLL_INTERVAL=250ms
OUTBOX_BACKOFF_BASE=1s
OUTBOX_BACKOFF_MAX=5m
# Published events older than this are deleted; 0 keeps them forever.
OUTBOX_RETENTION=0

# Pending reference worker
PENDING_POLL_INTERVAL=500ms
PENDING_LEASE=30s
PENDING_BATCH_SIZE=50
PENDING_BACKOFF_BASE=2s
PENDING_BACKOFF_MAX=5m
PENDING_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL=30m

# Tracing: OTLP/HTTP collector base URL. Empty disables span export; W3C trace context received
# over HTTP or SQS is still forwarded to SNS. With the "tracing" compose profile use http://jaeger:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1
